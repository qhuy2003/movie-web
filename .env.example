# Copy to .env and fill in credentials from your ZaloPay Sandbox merchant.
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query

# Optional: expose /payments/zalopay/callback through a public HTTPS URL (for example, a dev tunnel).
ZALOPAY_CALLBACK_URL=
FRONTEND_URL=http://localhost:5173
